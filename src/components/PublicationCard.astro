---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'research'> | CollectionEntry<'projects'> | CollectionEntry<'radar'>;
  href: string;
}

const { entry, href } = Astro.props;
const { data } = entry;
---

<article class="card">
  <p class="eyebrow">{data.department} · {data.status}</p>
  <h3><a href={href}>{data.title}</a></h3>
  <p>{data.summary}</p>
  <ul class="tags" aria-label="Tags">
    {data.tags.map((tag) => <li>{tag}</li>)}
  </ul>
</article>
