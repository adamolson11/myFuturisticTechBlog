---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return (await getCollection('projects')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <p class="eyebrow">{entry.data.department} · {entry.data.status} · maturity {entry.data.maturity_score}/6</p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.summary}</p>
    <Content />
  </article>
</BaseLayout>
