---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationCard from '../../components/PublicationCard.astro';

const entries = await getCollection('projects');
---

<BaseLayout title="Projects" description="Vale Lab's active and planned projects.">
  <p class="eyebrow">Compounding build queue</p>
  <h1>Projects</h1>
  <p class="lede">Each project is framed as a reusable system, not a one-off. Status reflects the current planning material.</p>
  <div class="grid">{entries.map((entry) => <PublicationCard entry={entry} href={`/projects/${entry.id}`} />)}</div>
</BaseLayout>
